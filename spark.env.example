# spark-engine deployment settings. Copy to spark.env (same file and paths on every node) and edit.

# This repository / release directory (same path on every node) and the Python environment with torch 2.13 cu130
SPARK_HOME=/opt/spark-engine
SPARK_PYTHON=$SPARK_HOME/.venv/bin/python
# The engine binary: the release's bin/spark-engine, or engine-rs/target/release/spark-engine after a source build
SPARK_BIN=$SPARK_HOME/bin/spark-engine
SPARK_PORT=8888

# ---- Nodes (GLM-5.3-Flash on 2 or 3 DGX Sparks, DeepSeek-V4.1-Flash on 3). Rank 0 runs on this node. ----
SPARK_WORKERS="root@10.0.1.1 root@10.0.3.2"       # ssh targets of ranks 1 and 2 (key-based login; TP2 uses the first)
SPARK_MASTER_ADDRS="10.0.1.2 10.0.1.2 10.0.3.1"   # address of rank 0 as seen from rank 0, 1, 2 (each over its own RoCE link)
SPARK_TP3_IFNAME=                                 # three nodes: an interface on which all of them reach each other, e.g. the LAN port (NCCL bootstrap only)

# ---- GLM-5.3-Flash, tensor-parallel over GLM_WORLD DGX Sparks ----
GLM_WORLD=2                                        # 2 or 3 (start.sh glm3 runs 3 whatever this says)
GLM_MODEL=/models/GLM-5.3-Flash-tr3-4bpw           # brandonmusic/GLM-5.3-Flash-tr3-4bpw (EXL3 4 bpw)
GLM_DRAFTER=/models/GLM-5.3-Flash-DFlash2          # incoai/GLM-5.3-Flash-DFlash2 (speculative drafter, CC BY-NC-ND 4.0)
GLM_MASTER_PORT=29931
GLM_PROFILE=$SPARK_HOME/engine-rs/profiles/glm.env
GLM_KV_TOKENS=1048576                              # KV budget in tokens (also the longest context)
# Two nodes: NCCL over the ConnectX-7 RoCE ports (DGX Spark defaults)
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_INDEX=3
# Engine RDMA all-reduce ports (defaults match DGX Spark): GLM53_RDMA_AR_DEV, GLM53_RDMA_AR_DEV1, GLM53_RDMA_AR_GID

# ---- Qwen3.8-Flash-Next, one DGX Spark ----
QWEN_MODEL=/models/Qwen3.8-Flash-Next-exl3         # turboderp/Qwen3.8-Flash-Next-exl3, revision 4.05bpw_h6_ng6
QWEN_ASSETS=$SPARK_HOME/assets/qwen38              # draft sub-vocabulary (draft_vocab_65536.json)
# QWEN_PCACHE=1                                    # persistent prefix cache on NVMe (QWEN_PCACHE_DIR, default /tmp/qwen38-prefix-cache)

# ---- Optional abliteration (off by default; see docs/abliteration.md) ----
# GLM53_ABLIT=1 ; GLM53_ABLIT_DIR=/models/glm53-ablit-transplant   # GLM o_proj transplant
# SPARK_ABLATE=/models/dirs.safetensors ; SPARK_ABLATE_MODE=subspace:16-40:8   # direction ablation (either model)
