# Topology env of two DGX Sparks (GLM_WORLD=2), sourced by glm-rank.sh after the profile and spark.env: NCCL over the
# ConnectX-7 RoCE ports (NET/IB is mandatory; NCCL_SOCKET_IFNAME is for bootstrap only) plus the engine's two-rank RDMA
# all-reduce and small-message paths enabled by the profile. Port names / GID come from spark.env.
export NCCL_NET=IB NCCL_NET_PLUGIN=none NCCL_IB_DISABLE=0 NCCL_CROSS_NIC=0
export NCCL_IB_HCA=${NCCL_IB_HCA:-rocep1s0f0,roceP2p1s0f0} NCCL_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME:-enp1s0f0np0} NCCL_IB_GID_INDEX=${NCCL_IB_GID_INDEX:-3}
