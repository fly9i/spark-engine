# Topology env of three DGX Sparks (GLM_WORLD=3, and DeepSeek-V4.1-Flash), sourced after the profile and spark.env. The
# profile is the same as TP2's; only the transport differs:
#   - every collective of the decode / verify / prefill path goes over the engine's N-way RDMA all-reduce and row
#     reduce-scatter / all-gather (shim/rdma_arn.cu). Links are found by subnet: each pair of nodes needs one directly
#     connected RoCE port pair on a shared subnet (e.g. one /30 per cable); sums are FP32 in fixed rank order;
#   - NCCL only bootstraps (and serves the rare non-FP32 or gather collectives) over sockets on SPARK_TP3_IFNAME, a
#     network interface on which all three nodes reach each other;
#   - the two-rank transports of tp2-rdma.env / the profile (pair RDMA all-reduce, small-comm kernels) are off.
export NCCL_SOCKET_IFNAME=${SPARK_TP3_IFNAME:?set SPARK_TP3_IFNAME in spark.env (an interface all three nodes share)} NCCL_IB_DISABLE=1
export GLM53_RDMA_ARN_INIT=1 GLM53_RDMA_AR=1
export GLM53_RDMA_AR_INIT=0 GLM53_TP_SMALL_COMM=0 GLM53_TP_SMALL_COMM_ACTIVE=0
# Prefill row reduce-scatter on a BF16 wire (peers' partial sums rounded, own rows FP32, rank-ordered FP32 sum) and the z
# all-gather as Half (L1): KL vs FP8 0.01370 -> 0.01367, prefill 8K / 32K 1663 / 1618 -> 1733 / 1684 tok/s (SPX1 V1.2 weights).
# Defaults only: a spark.env or GLM_EXTRA_ENV value (=0) wins.
export GLM53_RDMA_ARN_RS_BF16=${GLM53_RDMA_ARN_RS_BF16:-1} GLM53_PREFILL_SP_HALF_Z=${GLM53_PREFILL_SP_HALF_Z:-1}
# Prefill schedule (L0, bit for bit the 4096-row chunks): a prompt served alone is sent in 8192-row units that run as two
# 4096-row chunks in lockstep, every collective on a high-priority communication stream overlapping the other chunk's
# compute (a unit that cannot be paired runs as the two chunks one after the other); the row finish kernels' wait runs as
# a one-CTA launch so an early-issued finish does not keep SMs spinning. 8K / 32K prefill +3.5% / +3.3% (SPX1 V1.2).
# Defaults only, as above.
export GLM53_PREFILL_SP_PAIR=${GLM53_PREFILL_SP_PAIR:-1} GLM53_SERVE_CHUNK_SOLO=${GLM53_SERVE_CHUNK_SOLO:-8192}
export GLM53_RDMA_ARN_WAIT_SPLIT=${GLM53_RDMA_ARN_WAIT_SPLIT:-1} GLM53_COMM_STREAM_PRIO=${GLM53_COMM_STREAM_PRIO:-1}
