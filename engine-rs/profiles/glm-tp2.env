# GLM-5.3-Flash serving profile for two DGX Sparks (TP2): the engine's tuned defaults, sourced by engine-rs/serve/glm-rank.sh.
# Precision classes (docs/features.md): dense decode weights Q8 (int8 + one FP32 scale per 128) and the FP8 KV cache are
# lossy (L3); routed experts are the checkpoint's EXL3 4 bpw; prefill uses the dense weights at source precision.
# GLM53_MOE_COOP / GLM53_PREFILL_COOP select the engine's EXL3 MoE kernels (shim/moe_exl3.cuh) for decode and prefill.
# GLM53_PCACHE: persistent prefix cache on local NVMe (directory GLM53_PCACHE_DIR, default $SPARK_HOME/var/prefix-cache).
export GLM53_ACCEPTED_FEATURE_VIEW=1
export GLM53_AR_FUSED=1
